{
  "code": "sign",
  "variantgroups": [
    { "code": "type", "states": ["anvil", "hog", "cauldron"] },
    { "code": "material", "states": ["iron", "copper"], "loadFromProperties": "block/wood" },
    { "code": "side", "loadFromProperties": "abstract/horizontalorientation" }
  ],
  "behaviors": [
    {
      "name": "BracketMountable",
      "properties": {
        "facingCode": "side",
        "dropFacing": "north"
      }
    }
  ],
  "attributes": {
    "handbook": {
      "groupBy": ["sign-{type}-*"]
    }
  },
  "shapebytype": {
    "*-anvil-*-north": { "base": "block/sign/anvil", "rotateY": 180, "offsetX": -0.8125, "offsetY": 0.203125 },
    "*-anvil-*-east": { "base": "block/sign/anvil", "rotateY": 90, "offsetZ": -0.8125, "offsetY": 0.203125 },
    "*-anvil-*-south": { "base": "block/sign/anvil", "rotateY": 0, "offsetX": 0.8125, "offsetY": 0.203125 },
    "*-anvil-*-west": { "base": "block/sign/anvil", "rotateY": 270, "offsetZ": 0.8125, "offsetY": 0.203125 },
    "*-hog-*-north": { "base": "block/sign/hog", "rotateY": 180, "offsetX": -0.8125, "offsetY": 0.203125 },
    "*-hog-*-east": { "base": "block/sign/hog", "rotateY": 90, "offsetZ": -0.8125, "offsetY": 0.203125 },
    "*-hog-*-south": { "base": "block/sign/hog", "rotateY": 0, "offsetX": 0.8125, "offsetY": 0.203125 },
    "*-hog-*-west": { "base": "block/sign/hog", "rotateY": 270, "offsetZ": 0.8125, "offsetY": 0.203125 },
    "*-cauldron-*-north": { "base": "block/sign/cauldron", "rotateY": 180, "offsetX": -0.8125, "offsetY": 0.203125 },
    "*-cauldron-*-east": { "base": "block/sign/cauldron", "rotateY": 90, "offsetZ": -0.8125, "offsetY": 0.203125 },
    "*-cauldron-*-south": { "base": "block/sign/cauldron", "rotateY": 0, "offsetX": 0.8125, "offsetY": 0.203125 },
    "*-cauldron-*-west": { "base": "block/sign/cauldron", "rotateY": 270, "offsetZ": 0.8125, "offsetY": 0.203125 }
  },
  "texturesByType": {
    "*-*-iron-*": {
      "lead": { "base": "game:block/metal/ingot/iron" },
      "lead2": { "base": "game:block/metal/plate/iron" }
    },
    "*-*-copper-*": {
      "lead": { "base": "game:block/metal/ingot/copper" },
      "lead2": { "base": "game:block/metal/plate/copper" }
    },
    "*": {
      "lead": { "base": "game:block/wood/debarked/{material}" },
      "lead2": { "base": "game:block/wood/planks/{material}*" }
    }
  },
  "blockmaterialByType": {
    "*-*-iron-*": "Metal",
    "*-*-copper-*": "Metal",
    "*": "Wood"
  },
  "creativeinventory": {
    "general": ["*-oak-north"],
    "signageandmore": ["*-north"]
  },
  "replaceable": 900,
  "resistance": 1.5,
  "maxStackSize": 16,
  "lightAbsorption": 0,
  "sidesolid": { "all": false },
  "sideopaque": { "all": false },
  "faceCullMode": "NeverCull",
  "doNotRenderAtLod2": true,
  "collisionSelectionBoxesByType": {
    "*-north": [{ "x1": -0.8125, "y1": 0.203125, "z1": 0.4, "x2": 0.1875, "y2": 1.203125, "z2": 0.6 }],
    "*-east": [{ "x1": 0.4, "y1": 0.203125, "z1": -0.8125, "x2": 0.6, "y2": 1.203125, "z2": 0.1875 }],
    "*-south": [{ "x1": 0.8125, "y1": 0.203125, "z1": 0.4, "x2": 1.8125, "y2": 1.203125, "z2": 0.6 }],
    "*-west": [{ "x1": 0.4, "y1": 0.203125, "z1": 0.8125, "x2": 0.6, "y2": 1.203125, "z2": 1.8125 }]
  },
  "combustiblePropsByType": {
    "*-*-iron-*": null,
    "*-*-copper-*": null,
    "*": {
      "burnTemperature": 600,
      "burnDuration": 20
    }
  },
  "soundsByType": {
    "*-*-iron-*": {
      "place": "game:block/metal",
      "hit": "game:block/metal",
      "break": "game:block/metal"
    },
    "*-*-copper-*": {
      "place": "game:block/metal",
      "hit": "game:block/metal",
      "break": "game:block/metal"
    },
    "*": {
      "place": "game:block/planks",
      "hit": "game:block/planks",
      "break": "game:block/planks",
      "walk": "game:walk/wood"
    }
  },
  "guiTransform": {
    "rotation": { "x": -22, "y": 45, "z": 0 },
    "origin": { "x": 0.5, "y": 0.4, "z": 0.5 },
    "scale": 1.2
  }
}
